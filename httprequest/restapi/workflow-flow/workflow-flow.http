# Flow: start hello-world-process and verify the token position — see workflow-flow.md

### 1) start process with default input (gateway default branch, User03 = Default)
< ../../scripts/traceparent.js
POST {{host}}/restapi/workflow
Accept: application/json
Authorization: Basic {{username}} {{password}}
Content-Type: application/json
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=workflow-cib7-hello-world

{
    "input": "hallo"
}

> {%
    client.test("default input returns 200", function () {
        client.assert(response.status === 200, "expected 200 but got " + response.status);
    });
    client.test("default input starts hello-world-process", function () {
        client.assert(response.body.processDefinitionId.startsWith("hello-world-process"), "unexpected processDefinitionId");
        client.assert(!!response.body.processInstanceId, "processInstanceId missing");
        client.assert(!!response.body.id, "id missing");
    });
    client.global.set("processInstanceId", response.body.processInstanceId);
%}

### 2) default branch: read the token variable (status/input)
< ../../scripts/traceparent.js
GET {{host}}/engine-rest/process-instance/{{processInstanceId}}/variables/tokenVariable
Authorization: Basic {{username}} {{password}}
Accept: application/json
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=workflow-cib7-hello-world

> {%
    const token = response.body.value;
    client.log("default token status: " + (token ? token.status : "missing") + ", input: " + (token ? token.input.inputVariable : "missing"));
    client.test("default token variable is readable", function () {
        client.assert(response.status === 200, "expected 200 but got " + response.status);
        client.assert(!!token, "token value missing");
        client.assert(["STARTED", "RUNNING", "COMPLETED", "FINISHED", "BUSINESS_EXCEPTION"].indexOf(token.status) >= 0, "unexpected token status " + token.status);
        client.assert(token.input.inputVariable === "hallo", "unexpected token input");
    });
%}

### 3) default branch: read the token position (activity)
< ../../scripts/traceparent.js
GET {{host}}/engine-rest/process-instance/{{processInstanceId}}/activity-instances
Authorization: Basic {{username}} {{password}}
Accept: application/json
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=workflow-cib7-hello-world

> {%
    const root = response.body;
    const current = (root.childActivityInstances && root.childActivityInstances[0]) || (root.childTransitionInstances && root.childTransitionInstances[0]);
    client.log("default token position: " + (current ? current.activityId : "unknown"));
    client.test("default token is in the process", function () {
        client.assert(response.status === 200, "expected 200 but got " + response.status);
        client.assert(!!current, "no current activity or transition");
        client.assert(current.processInstanceId === client.global.get("processInstanceId"), "processInstanceId mismatch");
    });
%}

