### 4) start process with input fail (sayHelloDelegate raises BpmnError, boundary event path)
< ../../scripts/traceparent.js
POST {{host}}/restapi/workflow
Accept: application/json
Authorization: Basic {{username}} {{password}}
Content-Type: application/json
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=workflow-cib7-hello-world

{
    "input": "fail"
}

> {%
    client.test("fail input still starts the process with 200", function () {
        client.assert(response.status === 200, "expected 200 but got " + response.status);
    });
    client.test("fail input returns a process instance", function () {
        client.assert(!!response.body.processInstanceId, "processInstanceId missing");
    });
%}

### 5) start process without input field (validation error)
< ../../scripts/traceparent.js
POST {{host}}/restapi/workflow
Accept: application/json
Authorization: Basic {{username}} {{password}}
Content-Type: application/json
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=workflow-cib7-hello-world

{}

> {%
    client.test("missing input returns 400", function () {
        client.assert(response.status === 400, "expected 400 but got " + response.status);
    });
%}

### 6) start process with empty input (ValidateInputDelegate rejects empty input)
< ../../scripts/traceparent.js
POST {{host}}/restapi/workflow
Accept: application/json
Authorization: Basic {{username}} {{password}}
Content-Type: application/json
traceparent: 00-{{traceId}}-{{spanId}}-03
baggage: testBaggage=workflow-cib7-hello-world

{
    "input": ""
}

> {%
    client.test("empty input returns 400", function () {
        client.assert(response.status === 400, "expected 400 but got " + response.status);
    });
%}
