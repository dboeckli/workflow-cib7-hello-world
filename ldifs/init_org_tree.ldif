version: 1

##############################
# LDAP tree definition
##############################
dn: ${LDAP_INIT_ORG_DN}
dc: example
objectClass: top
objectClass: dcObject
objectClass: organization
o: Example, Inc

dn: ou=groups,${LDAP_INIT_ORG_DN}
objectClass: top
objectClass: organizationalUnit
ou: groups

dn: ou=users,${LDAP_INIT_ORG_DN}
objectClass: top
objectClass: organizationalUnit
ou: users
