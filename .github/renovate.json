{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "ignorePaths": [],
    "includePaths": ["**/*"],
    "extends": [
        "mergeConfidence:all-badges",
        "config:recommended"
    ],
    "ignorePresets": [
        "workarounds:javaLTSVersions"
    ],
    "customDatasources": {
        "custom_java": {
            "defaultRegistryUrlTemplate": "https://api.bell-sw.com/v1/liberica/versions",
            "format": "json",
            "transformTemplates": [
                "{ \"releases\": $map($[LTS=true and GA=true], function($v) { { \"version\": $string($v.featureVersion) } }) }"
            ]
        }
    },
    "enabledManagers": [
        "maven",
        "maven-wrapper",
        "docker-compose",
        "kubernetes",
        "helm-values",
        "helmv3",
        "custom.regex"
    ],

    "maven-wrapper": {
        "managerFilePatterns": [
            "/(^|/)mvnw$/",
            "/(^|/)mvnw.cmd$/",
            "/(^|/).mvn/wrapper/maven-wrapper.properties$/"
        ],
        "versioning": "maven"
    },
    "docker-compose": {
        "enabled": true
    },
    "kubernetes": {
        "managerFilePatterns": [
            "/k8s/.+\\.ya?ml$/",
            "/helm-charts/templates/.+\\.ya?ml$/"
        ]
    },
    "helm-values": {
        "managerFilePatterns": [
            "/helm-charts/.+/values\\.ya?ml$/"
        ]
    },
    "helmv3": {
        "managerFilePatterns": [
            "/(^|/)Chart\\.ya?ml$/"
        ]
    },
    "packageRules": [
        {
            "description": "Ignore Maven APIs/SPIs",
            "matchDatasources": [
                "maven"
            ],
            "matchPackageNames": [
                "org.apache.maven:*"
            ],
            "enabled": false
        },
        {
            "description": "Stay on Spring Boot 3.x - ignore major version updates",
            "matchDatasources": [
                "maven"
            ],
            "matchPackageNames": [
                "org.springframework.boot:spring-boot-starter-parent",
                "org.springframework.boot:*"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "enabled": false
        },
        {
            "description": "Resolve ch.guru.springframework.apifirst Maven packages on GitHub Packages",
            "matchDatasources": [
                "maven"
            ],
            "matchPackageNames": [
                "ch.guru.springframework.apifirst:apifirst-client"
            ],
            "registryUrls": [
                "https://maven.pkg.github.com/dboeckli/workflow-cib7-hello-world"
            ],
            "allowedVersions": "/^[0-9]+\\.[0-9]+\\.[0-9]+(-SNAPSHOT)?$/"
        },
        {
            "matchCategories": [
                "docker"
            ],
            "registryUrls": [
                "https://index.docker.io"
            ]
        },
        {
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "/^domboeckli//"
            ],
            "versioning": "maven",
            "allowedVersions": "/^[0-9]+\\.[0-9]+\\.[0-9]+(-SNAPSHOT)?$/",
            "ignoreUnstable": false,
            "automerge": false,
            "automergeType": "pr",
            "ignoreTests": true
        },
        {
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "!/^domboeckli//"
            ],
            "automerge": false,
            "automergeType": "pr",
            "ignoreTests": true
        },
        {
            "description": "Keep MockServer Maven client and Docker image in one PR",
            "matchDatasources": ["maven", "docker"],
            "matchPackageNames": [
                "org.mock-server:*",
                "mockserver/mockserver"
            ],
            "groupName": "mockserver",
            "separateMajorMinor": false,
            "separateMinorPatch": false
        }
    ],
    "customManagers": [
        {
            "description": "Parse and change the java version from pom.xml",
            "customType": "regex",
            "datasourceTemplate": "custom.custom_java",
            "depNameTemplate": "java",
            "managerFilePatterns": [
                "/(^|\\/)pom\\.xml$/"
            ],
            "matchStrings": [
                "<java\\.version>(?<currentValue>\\d+)</java\\.version>"
            ],
            "autoReplaceStringTemplate": "<java.version>{{{newValue}}}</java.version>"
        },
        {
            "description": "Parse and change JAVA_VERSION in GitHub workflows",
            "customType": "regex",
            "datasourceTemplate": "custom.custom_java",
            "depNameTemplate": "java",
            "managerFilePatterns": [
                "/^\\.github\\/workflows\\/(release|maven-build|deploy-and-test-cluster)\\.ya?ml$/"
            ],
            "matchStrings": [
                "  JAVA_VERSION:[\\t ]*(?<currentValue>\\d+)"
            ],
            "autoReplaceStringTemplate": "  JAVA_VERSION: {{{newValue}}}"
        },
        {
            "description": "Parse and update MockServer version in pom.xml",
            "customType": "regex",
            "datasourceTemplate": "maven",
            "depNameTemplate": "org.mock-server:mockserver-junit-jupiter-no-dependencies",
            "managerFilePatterns": [
                "/(^|\\/)pom\\.xml$/"
            ],
            "matchStrings": [
                "<mock-server\\.version>(?<currentValue>[^<]+)</mock-server\\.version>"
            ],
            "autoReplaceStringTemplate": "<mock-server.version>{{{newValue}}}</mock-server.version>"
        },
        {
            "description": "Parse and update MockServer Docker image version in Java test files",
            "customType": "regex",
            "datasourceTemplate": "docker",
            "depNameTemplate": "mockserver/mockserver",
            "managerFilePatterns": [
                "/\\.java$/"
            ],
            "matchStrings": [
                "\"mockserver/mockserver:(?<currentValue>[^\"]+)\""
            ],
            "autoReplaceStringTemplate": "\"mockserver/mockserver:{{{newValue}}}\""
        },
        {
            "description": "Update the pinned Paketo builder used by spring-boot:build-image (TODO: remove pin once https://github.com/paketo-buildpacks/builder-noble-java-tiny/issues/344 is fixed; with Spring Boot 4.2.x switch to the new default paketobuildpacks/ubuntu-resolute-builder)",
            "customType": "regex",
            "datasourceTemplate": "docker",
            "depNameTemplate": "paketobuildpacks/builder-noble-java-tiny",
            "versioningTemplate": "docker",
            "managerFilePatterns": [
                "/(^|\\/)pom\\.xml$/"
            ],
            "matchStrings": [
                "<spring-boot\\.build-image\\.builder>paketobuildpacks/builder-noble-java-tiny:(?<currentValue>\\d+\\.\\d+\\.\\d+)</spring-boot\\.build-image\\.builder>"
            ]
        },
        {
            "description": "Update shfmt version pinned in pom.xml (spotless shfmt formatter) and GitHub workflows (mfinelli/setup-shfmt)",
            "customType": "regex",
            "datasourceTemplate": "github-tags",
            "depNameTemplate": "mvdan/sh",
            "extractVersionTemplate": "^v?(?<version>.*)$",
            "managerFilePatterns": [
                "/(^|\\/)pom\\.xml$/",
                "/^\\.github\\/workflows\\/(maven-build|release)\\.ya?ml$/"
            ],
            "matchStrings": [
                "<shfmt>\\s*<version>(?<currentValue>\\d+\\.\\d+\\.\\d+)</version>",
                "shfmt-version:[\\t ]*(?<currentValue>\\d+\\.\\d+\\.\\d+)"
            ]
        }
    ],
    "platformAutomerge": false,
    "dependencyDashboard": true,
    "prHourlyLimit": 0,
    "prConcurrentLimit": 0,
    "baseBranchPatterns": [
        "master"
    ],
    "branchPrefix": "feature/renovate-",
    "separateMinorPatch": true,
    "separateMajorMinor": true,
    "automerge": false,
    "rebaseWhen": "conflicted"
}